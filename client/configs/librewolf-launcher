#!/bin/sh
# myi2pd LibreWolf Launcher - Enforces RAM-only storage profile to prevent digital forensics

export HOME=/tmp/librewolf-session
mkdir -p /tmp/librewolf-session/.librewolf
cp /etc/librewolf/librewolf.overrides.cfg /tmp/librewolf-session/.librewolf/

# Execute the actual LibreWolf binary passing any arguments
# Include --no-sandbox to allow running as the root user in the diskless live RAM environment
exec librewolf --no-sandbox "$@"
