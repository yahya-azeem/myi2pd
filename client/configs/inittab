# /etc/inittab - Custom inittab for myi2pd automatic console autologin

::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::single:/sbin/openrc single

# Run console autologin wrapper on tty1 instead of standard login prompting getty
tty1::respawn:/sbin/getty -n -l /usr/local/bin/autologin 38400 tty1

# Keep remaining terminals standard for safety
tty2::respawn:/sbin/getty 38400 tty2
tty3::respawn:/sbin/getty 38400 tty3
tty4::respawn:/sbin/getty 38400 tty4
tty5::respawn:/sbin/getty 38400 tty5
tty6::respawn:/sbin/getty 38400 tty6

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
