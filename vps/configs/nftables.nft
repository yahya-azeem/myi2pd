table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        # Allow established loopback traffic
        iif "lo" accept

        # Allow established/related connections
        ct state established,related accept

        # VLESS + XTLS-Reality endpoint (disguised as standard HTTPS on port 443)
        tcp dport 443 accept
        udp dport 443 accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        # Forward traffic originating from the VLESS tunnel interface
        iifname "tun+" accept

        # Forward return traffic for established connections
        oifname "tun+" ct state established,related accept
    }

    chain output {
        type filter hook output priority 0; policy drop;

        # Rule 1: Allow loopback for internal IPC/proxies
        oif "lo" accept

        # Rule 2: Allow local DNS queries
        udp dport 53 accept

        # Rule 3: Allow connection to the VPS IP on port 443 (VLESS + XTLS-Reality)
        ip daddr @vps_ip tcp dport 443 accept
        ip daddr @vps_ip udp dport 443 accept

        # Rule 4: Allow SOCKS (4447) and DNS (53) to VPS directly (for proxy even before tun0)
        ip daddr @vps_ip tcp dport 4447 accept
        ip daddr @vps_ip tcp dport 53 accept
        ip daddr @vps_ip udp dport 53 accept

        # Rule 5: Allow all traffic over the established VPN tunnel interface
        oif "tun0" accept
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority 100; policy accept;

        # Masquerade traffic from the VPN subnet (10.10.10.0/24) out to the WAN
        ip saddr 10.10.10.0/24 masquerade
    }
}